# Local development: copy this file to .env and fill in real values.
#   cp .env.example .env
#
# Production (Netlify): do NOT rely on a .env file (it is gitignored and
# never deployed). Instead set the same keys in:
#   Netlify dashboard > Site configuration > Environment variables
# with scope "Same value for all deploy contexts" (or at least
# "Functions"/"All scopes"), then trigger a new deploy.
RESEND_API_KEY=replace-with-resend-api-key
CONTACT_FROM_EMAIL=explore-asia@buggyless.com
CONTACT_TO_EMAIL=roshan@exploreasiatravels.com
CONTACT_LOGO_URL=https://www.exploreasiatravels.com/favicon.png
